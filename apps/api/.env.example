PORT=3001

# Required for POST /sessions/analyze and POST /coach/chat in local/dev.
# Server-side only. Never put this in EXPO_PUBLIC_* or the mobile app.
# Without it those routes return 503 instead of a mock reply.
OPENAI_API_KEY=

# Optional model overrides (defaults shown).
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Local SQLite file (created automatically). Use :memory: only for tests.
# No hosted database or cloud vendor account is required.
DATABASE_PATH=./data/triadapt.sqlite

# Auth session lifetime in days. Tokens are random bearer values; only a
# SHA-256 hash is stored. There is no shared secret in the mobile app.
AUTH_SESSION_DAYS=30

# scrypt N (power of 2). Tests default to 4. Leave unset for local/prod.
# AUTH_SCRYPT_N=16384

# Per-IP rate limit for /auth/register and /auth/login.
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

# Production: POST /sessions/analyze and POST /coach/chat require a signed-in
# user (401 without a valid Bearer token). Local `npm run dev:api` still allows
# those routes without a session so smoke tests keep working.
# NODE_ENV=development

# Browser Origin allowlist (comma-separated). Requests with no Origin header
# (native iOS/Android / curl) are allowed. In production, unlisted browser
# origins are rejected. Locally, an empty list still allows localhost / LAN.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Per-IP rate limit for /sessions/analyze and /coach/chat.
# Set AI_RATE_LIMIT_MAX=0 to disable (tests only).
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=30

# Encoded-media payload limits (data URIs). These are NOT the text limits.
AI_JSON_BODY_LIMIT=8mb
AI_MAX_PAYLOAD_CHARS=6000000
AI_MAX_MEDIA_BYTES=4194304

# Bounded AI text / context (enforced before OpenAI, except Whisper for audio).
AI_MAX_ANALYZE_TEXT_CHARS=20000
AI_MAX_COACH_MESSAGES=30
AI_MAX_COACH_MESSAGE_CHARS=8000
AI_MAX_COACH_CONTEXT_CHARS=100000
AI_MAX_RECENT_SESSIONS=50
AI_MAX_WEEK_PLAN_SESSIONS=21
AI_MAX_SESSION_NOTES_CHARS=4000

# Set true only behind a trusted reverse proxy so req.ip is the client.
TRUST_PROXY=
