{
  "all": true,
  "include": [
    "src/ai/**/*.ts",
    "src/lib/**/*.ts",
    "src/routes/**/*.ts",
    "src/middleware/**/*.ts",
    "src/app.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "src/index.ts",
    "src/mocks/**",
    "src/types.ts"
  ],
  "reporter": ["text", "lcov"],
  "reportsDirectory": "coverage",
  "check-coverage": true,
  "lines": 80,
  "functions": 80,
  "branches": 70,
  "statements": 80
}
