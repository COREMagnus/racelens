    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "c8": "^12.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2"
